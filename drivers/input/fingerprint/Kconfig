menuconfig INPUT_FINGERPRINT
	bool "Fingerprint"
	depends on ARCH_ONEPLUS_MSM8998
	help
	  Say Y here, and a list of supported fingerprint will be displayed.
	  This option doesn't affect the kernel.

	  If unsure, say Y.

if INPUT_FINGERPRINT

config FINGERPRINT_DETECT
	bool "OnePlus fingerprint sensor detection"

config FINGERPRINT_FPC
	bool "FPC fingerprint sensor support"

config FINGERPRINT_GOODIX
	bool "Goodix fingerprint sensor support"
endif
